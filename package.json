{
  "name": "yannbraga.dev",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node ./scripts/generate-sitemap",
    "serve": "next start",
    "analyze": "cross-env ANALYZE=true next build",
    "lint": "next lint --fix --dir pages --dir components --dir lib --dir layouts --dir scripts",
    "prepare": "husky",
    "storybook": "npx storybook dev -p 6006",
    "build-storybook": "npx storybook build",
    "storybook-blog": "yarn storybook --config-dir .storybook-blog",
    "build-storybook-blog": "npx storybook build --config-dir .storybook-blog",
    "chromatic": "npx chromatic --exit-zero-on-changes --only-changed"
  },
  "dependencies": {
    "@code-hike/mdx": "^0.9.0",
    "@emotion/react": "^11.10.0",
    "@fontsource/inter": "4.5.2",
    "@mailchimp/mailchimp_marketing": "^3.0.58",
    "@tailwindcss/forms": "^0.5.2",
    "@tailwindcss/typography": "^0.5.4",
    "autoprefixer": "^10.4.5",
    "esbuild": "0.28.2",
    "github-slugger": "^1.3.0",
    "gray-matter": "^4.0.2",
    "image-size": "1.0.0",
    "kbar": "1.0.0",
    "lottie-react": "2.4.2",
    "mdx-bundler": "9.2.1",
    "next": "15.5.24",
    "next-themes": "^0.0.14",
    "postcss": "^8.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-scroll-progress-bar": "^1.1.13",
    "reading-time": "1.3.0",
    "rehype-autolink-headings": "6.1.1",
    "rehype-citation": "0.4.0",
    "rehype-katex": "7.0.1",
    "rehype-preset-minify": "6.0.0",
    "rehype-slug": "5.1.0",
    "remark-gfm": "3.0.1",
    "remark-math": "5.1.1",
    "sharp": "0.33.5",
    "shiki": "^0.11.0",
    "tailwindcss": "^3.1.8",
    "unist-util-visit": "4.1.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@next/bundle-analyzer": "^15.5.0",
    "@storybook/addon-essentials": "^8.6.0",
    "@storybook/addon-interactions": "^8.6.0",
    "@storybook/addon-links": "^8.6.0",
    "@storybook/nextjs": "^8.6.0",
    "@storybook/testing-library": "^0.2.2",
    "@svgr/webpack": "^8.1.0",
    "chromatic": "^11.0.0",
    "cross-env": "^7.0.3",
    "dedent": "^1.5.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-storybook": "^0.11.0",
    "file-loader": "^6.0.0",
    "globby": "^11.0.3",
    "husky": "^9.0.11",
    "inquirer": "^8.1.1",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.13",
    "storybook": "^8.6.0"
  },
  "overrides": {
    "autoprefixer": "10.4.5"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  }
